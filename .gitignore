hw/soc/tb/cocotb/sim_build_mutb_*/
hw/soc/tb/cocotb/results_mutb_*.xml
hw/soc/pnr/state/

# docs/47: the place-and-route flow. Generated and fetched, never
# vendored -- the rule docs/38 section 11 states. The state file names
# an absolute path to a netlist and is written by flow/pnr_soc_top.sh.
hw/soc/pnr/runs/
hw/soc/pnr/config.resolved.json
hw/soc/pnr/state/

# docs/48: the floorplan variants. hw/soc/pnr/floorplan.py writes them
# from the PDK's own LEF and from config.json, and reproduces docs/47's
# floorplan exactly at --channel 700.08 --density 40, so committing one
# would be vendoring a thing the tree can regenerate.
hw/soc/pnr/config-fp*.json

# docs/73: config-ecc.json plus MANUAL_GLOBAL_PLACEMENTS, written by
# hw/soc/pnr/clint_region.py config from the tracked clint_placement.json.
hw/soc/pnr/config-ecc-clint*.json

# scripts/run_cocotb.sh single-run lock
.run_cocotb.lock

# formal/eqy build output
formal/eqy/out/
