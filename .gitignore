# SymbiYosys working directories: one per task. The .sby configs and the
# property files are the tracked source; these are regenerated output.
formal/aer_fifo/
formal/aer_fifo_*/
formal/npu_regbank/
formal/npu_regbank_*/
formal/secded/
formal/secded_*/
formal/tmr_voter/
formal/tmr_voter_*/
formal/lif_ctrl/
formal/lif_ctrl_*/
formal/lif_mem/
formal/lif_mem_*/
formal/scrub/
formal/scrub_*/

# generated documentation site
_site/
_site_builtin/

# physical flow run outputs
hw/openlane/runs/
hw/openlane/*/runs/
tt/runs/

# tt-support-tools is cloned in for the submission checks, not vendored
tt/tt/

# Ibex bring-up (hw/soc, docs/38). Same rule as tt/tt/ above: fetched in
# for a check, not vendored. `ext/` is a 700 MB upstream git clone,
# `tools/` is two downloaded toolchains (sv2v, riscv-none-elf-gcc), and
# `gen/`, `out/` are regenerated by hw/soc/flow/. The tracked sources
# are hw/soc/{flow,rtl,tb,syn,sta,fi}/ and hw/soc/tools.soc.mk, which pins
# every one of the fetched things by commit or sha256 so that what is
# ignored is still reproducible.
hw/soc/ext/
hw/soc/tools/
hw/soc/gen/
# hw/soc/genp/ is gen/ibex_top.v with the register file's fault port
# added, written by flow/ibex_fault_port.py (docs/44 section 4). Same
# rule: derived from a pinned input by a tracked script, never
# vendored and never edited by hand.
hw/soc/genp/
hw/soc/out/

# SymbiYosys working directories for the SoC fabric jobs (docs/39). Same
# rule as the formal/ entries above: the .sby configs and the property
# files are the tracked source, these are regenerated output.
hw/soc/formal/soc_bus/
hw/soc/formal/soc_bus_*/
hw/soc/formal/soc_apb_bridge/
hw/soc/formal/soc_apb_bridge_*/
hw/soc/formal/soc_clint/
hw/soc/formal/soc_clint_*/
hw/soc/formal/soc_wdog/
hw/soc/formal/soc_wdog_*/
hw/soc/formal/regfile_secded/
hw/soc/formal/regfile_secded_*/
hw/soc/formal/soc_busstat/
hw/soc/formal/soc_busstat_*/

# docs/47: the place-and-route flow. Generated and fetched, never
# vendored -- the rule docs/38 section 11 states. The state file names
# an absolute path to a netlist and is written by flow/pnr_soc_top.sh.
hw/soc/pnr/runs/
hw/soc/pnr/config.resolved.json
hw/soc/pnr/state/
