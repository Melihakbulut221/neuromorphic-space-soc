# SymbiYosys job for the memory codec's counters and the scrubbers'
# control, hw/soc/rtl/soc_scrub.v (docs/67).
#
#   sby -f soc_scrub.sby prove       k-induction proof of C1-C7
#   sby -f soc_scrub.sby prove_w16   the same at the shipped counter width
#   sby -f soc_scrub.sby bmc         bounded check, depth 20
#   sby -f soc_scrub.sby cover       reachability of every proven behaviour
#
# Properties live in soc_scrub_props.v, textually included at the end
# of the soc_scrub module body under `ifdef FORMAL, the arrangement
# soc_busstat and the other fabric blocks use.
#
# CNT_W IS 4 HERE AND 16 IN THE DESIGN, for soc_busstat.sby's reason:
# saturation has to be reachable inside a bounded model for its cover to
# mean anything, and a counter that needs 65,535 increments cannot be
# driven to its top in one. prove_w16 proves the whole set again at the
# shipped width without the saturation cover.

[tasks]
bmc
prove
prove_w16
cover

[options]
bmc: mode bmc
bmc: depth 20
prove: mode prove
prove: depth 10
prove_w16: mode prove
prove_w16: depth 10
cover: mode cover
cover: depth 24

[engines]
smtbmc yices

[script]
read_verilog -formal soc_scrub.v
~prove_w16: chparam -set CNT_W 4 soc_scrub
prove_w16: chparam -set CNT_W 16 soc_scrub
prep -top soc_scrub

[files]
../rtl/soc_scrub.v
soc_scrub_props.v
