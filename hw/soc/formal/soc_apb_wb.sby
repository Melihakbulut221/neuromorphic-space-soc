# SymbiYosys job for the APB completer to Wishbone B3 classic initiator
# bridge, the one bridge docs/65 section 9.4 found serves two of the four
# selected cores (Mohor CAN and verilog-i2c, both Wishbone classic with
# an 8-bit data path).
#
#   sby -f soc_apb_wb.sby prove    k-induction proof of I1, W1-W8, P1-P3,
#                                  D1-D2
#   sby -f soc_apb_wb.sby bmc      bounded check, depth 24
#   sby -f soc_apb_wb.sby cover    reachability of every proven
#                                  behaviour, including a cycle with
#                                  three wait states, an ERR and an RTY
#                                  termination, and a byte on the top
#                                  lane
#
# Properties live in soc_apb_wb_props.v, textually included at the end
# of the soc_apb_wb module body under `ifdef FORMAL. They are clauses of
# the Wishbone B3 datasheet and of the AMBA 3 APB specification, not
# restatements of the state machine -- the file's own header says which
# property came from which document. The APB requester is assumed to
# obey the protocol; soc_apb_bridge.sby proves that the fabric's
# requester does, which is what makes the composition sound.
#
# Same shape as soc_apb_bridge.sby, deliberately: docs/39 section 5.3
# set the standard that a bridge here has its compliance proved by
# k-induction rather than asserted, and the second bridge is held to the
# first one's harness.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 24

[engines]
smtbmc yices

[script]
read_verilog -formal soc_apb_wb.v
prep -top soc_apb_wb

[files]
../rtl/soc_apb_wb.v
soc_apb_wb_props.v
