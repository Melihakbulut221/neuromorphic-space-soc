# SymbiYosys job for the watchdog.
#
#   sby -f soc_wdog.sby prove    k-induction proof of W1-W5
#   sby -f soc_wdog.sby bmc      bounded check, depth 40
#   sby -f soc_wdog.sby cover    reachability of the whole escalation
#                                ladder, which is what stops a set of
#                                pure safety properties from being
#                                satisfied by a block that does nothing
#
# Properties live in soc_wdog_props.v, textually included at the end of
# the soc_wdog module body under `ifdef FORMAL (read_verilog -formal
# defines FORMAL). They are the five requirements W1-W5 of the RTL's own
# header, which docs/40-interrupts-timers-watchdog.md section 5 argues
# and which were written before the RTL.
#
# THE PARAMETERS ARE SMALL ON PURPOSE. WIDTH 8 and PRESCALE 4 make a full
# timeout 1,024 clocks instead of the million soc_top.v instantiates, and
# RST_CYCLES 4 keeps the reset pulse inside a bounded check. What is
# proved is therefore the POLICY at one configuration, not the policy at
# every configuration -- and in particular the cover task's claim that
# stage 3 is reachable is a claim about ESCALATE = 2. The behaviour is
# parameterised; the proof is at one point.

[tasks]
bmc
prove
cover

[options]
bmc: mode bmc
bmc: depth 40
prove: mode prove
prove: depth 15
cover: mode cover
cover: depth 60

[engines]
smtbmc yices

[script]
read_verilog -formal soc_wdog.v
chparam -set WIDTH 8 -set PRESCALE 4 -set RST_CYCLES 4 -set ESCALATE 2 soc_wdog
prep -top soc_wdog

[files]
../rtl/soc_wdog.v
soc_wdog_props.v
