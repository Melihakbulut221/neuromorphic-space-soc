# SymbiYosys job for the system bus to APB bridge.
#
#   sby -f soc_apb_bridge.sby prove    k-induction proof of A1-A11
#   sby -f soc_apb_bridge.sby bmc      bounded check, depth 24
#   sby -f soc_apb_bridge.sby cover    reachability of every proven
#                                      behaviour, including a transfer
#                                      with three wait states
#   sby -f soc_apb_bridge.sby prove_to the same, at APB_TIMEOUT = 8
#   sby -f soc_apb_bridge.sby cover_to a timeout actually happening
#
# TWO PARAMETER POINTS, because APB_TIMEOUT = 0 and APB_TIMEOUT != 0 are
# different machines and the properties differ between them. At 0 the
# timeout arm does not exist and A9 and A10 hold with no antecedent --
# that is the shipping netlist. At 8 the bridge may release the fabric
# with a synthesised error after a bounded wait, so A9's "never
# otherwise" and A10's "what the peripheral returned" are deviated from
# by construction, which the props file states in full beside each one.
# A12 is what holds the deviation honest: whatever the timeout does,
# PSEL and PENABLE stay asserted, so it is never a master-side abort.
# Proving only the default would be proving the parameter is unused.
#
# Properties live in soc_apb_bridge_props.v, textually included at the
# end of the soc_apb_bridge module body under `ifdef FORMAL. They are
# clauses of the AMBA 3 APB specification and of the Ibex memory protocol
# (quoted in the header of hw/soc/rtl/soc_bus.v), not restatements of the
# state machine -- the file's own header says which property came from
# which document.
#
# This is the whole reason APB was implemented and AHB was not. The
# protocol is small enough that its compliance is a proof rather than an
# assertion; docs/39-soc-bus-and-memory-map.md section 4 makes that
# argument and this job is what backs it.

[tasks]
bmc
prove
cover
prove_to
cover_to

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 24
prove_to: mode prove
prove_to: depth 16
cover_to: mode cover
cover_to: depth 24

[engines]
smtbmc yices

[script]
read_verilog -formal soc_apb_bridge.v
prove_to: chparam -set APB_TIMEOUT 8 soc_apb_bridge
cover_to: chparam -set APB_TIMEOUT 8 soc_apb_bridge
prep -top soc_apb_bridge

[files]
../rtl/soc_apb_bridge.v
soc_apb_bridge_props.v
