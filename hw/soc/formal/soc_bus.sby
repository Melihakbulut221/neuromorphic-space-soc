# SymbiYosys job for the system fabric.
#
#   sby -f soc_bus.sby prove    k-induction proof of F1-F9
#   sby -f soc_bus.sby bmc      bounded check, depth 24
#   sby -f soc_bus.sby cover    reachability of every proven behaviour
#
# AND THE SAME THREE AT REQ_REG = 1, the registered request phase of
# docs/84: prove_rr, bmc_rr, cover_rr. They are TASKS and not an edit to
# the default, the way regfile_scrub.sby sets SCRUB, so that the three
# jobs above stay the three jobs this project has been publishing --
# same script, same engine, same depths -- and the parameter is
# something the harness passes rather than something the design carries.
# Every task that passed before the parameter existed must pass at both
# settings; docs/84 section 4 is the record of what they printed.
#
# Properties live in soc_bus_props.v, textually included at the end of
# the soc_bus module body under `ifdef FORMAL (read_verilog -formal
# defines FORMAL). soc_memmap.vh is listed in [files] as well, because
# both the design and the decode properties read the generated address
# constants out of it -- the point of proving the decode at all is that
# it is proved against the frozen map rather than against itself.
#
# The cover task is not optional. docs/09-formal-verification-plan.md
# section B.1 makes an assert set with unreachable behaviour a red
# result, and several properties here (the outstanding limit, a full
# slave queue, two responses in one cycle) are exactly the kind that a
# too-strong environment assumption would quietly make unreachable.

[tasks]
bmc      base bmc
prove    base prove
cover    base cover
bmc_rr   rr   bmc
prove_rr rr   prove
cover_rr rr   cover

[options]
bmc: mode bmc
bmc: depth 24
prove: mode prove
prove: depth 12
cover: mode cover
cover: depth 24

[engines]
smtbmc yices

[script]
read_verilog -I. -formal soc_bus.v
# The chparam needs a derived hierarchy to bind to, and `prep` would
# derive it too late. Both lines are task-prefixed so that the default
# tasks run the script they have always run.
rr: hierarchy -check -top soc_bus
rr: chparam -set REQ_REG 1 soc_bus
prep -top soc_bus

[files]
../rtl/soc_bus.v
../rtl/soc_memmap.vh
soc_bus_props.v
