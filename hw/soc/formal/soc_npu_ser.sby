# SymbiYosys job for the NPU serial transport.
#
#   sby -f soc_npu_ser.sby prove    k-induction proof of P, H and D
#   sby -f soc_npu_ser.sby bmc      bounded check
#   sby -f soc_npu_ser.sby cover    reachability of a completed frame
#   sby -f soc_npu_ser.sby prove_h3 the same at SER_HALF = 3
#
# Properties live in soc_npu_ser_props.v, textually included at the end
# of the module body under `ifdef FORMAL. They are written against
# hw/rtl/pilot_top.v section 2 -- the frame format and the three host
# obligations H1, H2 and H3 -- and not against the state encoding of the
# module they check; that file's header says which of them are and are
# not provable here.
#
# The cover task is not optional. docs/09-formal-verification-plan.md
# section B.1 makes an assert set with unreachable behaviour a red
# result, and a transport that never left ST_IDLE would satisfy every
# assertion in the file.
#
# TWO PARAMETER POINTS, because H1's whole content is a RATE and a proof
# at one rate says nothing about another. HALF = 2 is the default and is
# the documented limit; HALF = 3 is the configuration a bench driving
# real silicon over an independent clock would need.

[tasks]
bmc
prove
cover
prove_h3

[options]
bmc: mode bmc
bmc: depth 30
prove: mode prove
prove: depth 16
cover: mode cover
cover: depth 220
prove_h3: mode prove
prove_h3: depth 16

[engines]
smtbmc yices

[script]
read_verilog -formal soc_npu_ser.v
prove_h3: chparam -set HALF 3 soc_npu_ser
prep -top soc_npu_ser

[files]
../rtl/soc_npu_ser.v
soc_npu_ser_props.v
