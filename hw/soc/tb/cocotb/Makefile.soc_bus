# cocotb + Icarus suite for hw/soc/rtl/soc_bus.v.
#
#   cd hw/soc/tb/cocotb && make -f Makefile.soc_bus        run the suite
#   cd hw/soc/tb/cocotb && make -f Makefile.soc_bus lint   Verilator lint
#
# The expectations in test_soc_bus.py come from the Ibex load/store unit
# protocol (ext/ibex/doc/03_reference/load_store_unit.rst) and from the
# generated memory map sw/golden/memmap_gen.py, not from the RTL, so this
# suite is meant to keep failing usefully when regmap/memmap.yaml changes.
#
# Standalone by design, same structure as hw/tb/Makefile.regbank. Same
# rootless tool discovery as that file: iverilog from PATH, cocotb from the
# project venv hw/.venv -- if cocotb-config is not already on PATH the
# recipe re-invokes make with the venv prepended, because make < 4.4 does
# not pass an exported PATH into $(shell ...), which the cocotb makefiles
# rely on. The venv is three directories up from here (hw/.venv), not in
# hw/soc.

SIM ?= icarus
TOPLEVEL_LANG ?= verilog

THIS_MK := $(lastword $(MAKEFILE_LIST))

VENV_BIN := $(abspath $(dir $(THIS_MK))/../../../.venv/bin)

ifeq ($(shell command -v cocotb-config 2>/dev/null),)

GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@

else

RTL = $(PWD)/../../rtl

# SOC_BUS_SRC exists so a mutation run can point the same suite at a
# modified copy of the RTL without editing the tree
# (make -f Makefile.soc_bus SOC_BUS_SRC=/path/to/mutant.v SIM_BUILD=... ).
SOC_BUS_SRC ?= $(RTL)/soc_bus.v

VERILOG_SOURCES = $(SOC_BUS_SRC)
TOPLEVEL = soc_bus
MODULE = test_soc_bus

# Per-block build and results paths so this suite can run alongside the
# others without clobbering their artifacts.
SIM_BUILD ?= sim_build_soc_bus
COCOTB_RESULTS_FILE ?= results_soc_bus.xml
export COCOTB_RESULTS_FILE

# soc_bus.v includes soc_memmap.vh, which is generated next to it.
COMPILE_ARGS += -I$(RTL)
COMPILE_ARGS += $(EXTRA_COMPILE_ARGS)

include $(shell cocotb-config --makefiles)/Makefile.sim

# Default-flag Verilator lint. The decode is the one place in this block
# where an implicit width extension would silently widen a prefix compare.
VERILATOR ?= $(firstword $(shell command -v verilator 2>/dev/null) \
	$(wildcard $(HOME)/oss-cad-suite/bin/verilator \
	           $(HOME)/Documents/gt2n-soc/tools/oss-cad-suite/bin/verilator \
	           $(HOME)/Downloads/oss-cad-suite-linux-x64-20260804/oss-cad-suite/bin/verilator))

.PHONY: lint
lint:
	@test -n "$(VERILATOR)" || \
		{ echo "verilator not found: install oss-cad-suite or put it on PATH"; exit 1; }
	$(VERILATOR) --lint-only -I$(RTL) $(SOC_BUS_SRC)

endif
