# cocotb + Icarus suite for hw/soc/rtl/soc_gptimer.v.
#
#   cd hw/soc/tb/cocotb && make -f Makefile.soc_gptimer        run the suite
#   cd hw/soc/tb/cocotb && make -f Makefile.soc_gptimer lint   Verilator lint
#
# The expectations in test_soc_gptimer.py come from GRLIB's GPTIMER
# register map (grip.pdf table 463), from AMBA 3 APB, and from the
# generated memory map sw/golden/memmap_gen.py -- not from the RTL.
#
# Standalone by design, same structure as hw/tb/Makefile.regbank. Same
# rootless tool discovery as that file: iverilog from PATH, cocotb from the
# project venv hw/.venv -- if cocotb-config is not already on PATH the
# recipe re-invokes make with the venv prepended, because make < 4.4 does
# not pass an exported PATH into $(shell ...), which the cocotb makefiles
# rely on. The venv is three directories up from here (hw/.venv), not in
# hw/soc.

SIM ?= icarus
TOPLEVEL_LANG ?= verilog

THIS_MK := $(lastword $(MAKEFILE_LIST))

VENV_BIN := $(abspath $(dir $(THIS_MK))/../../../.venv/bin)

ifeq ($(shell command -v cocotb-config 2>/dev/null),)

GOALS := $(if $(MAKECMDGOALS),$(MAKECMDGOALS),sim)
.PHONY: $(GOALS)
$(GOALS):
	@PATH="$(VENV_BIN):$$PATH" $(MAKE) -f $(THIS_MK) --no-print-directory $@

else

RTL = $(PWD)/../../rtl

# hw/rtl/tmr_voter.v is READ, never modified: it is the proved,
# golden-vector-tested majority primitive and docs/34 freezes the
# directory it lives in. See hw/soc/rtl/soc_wdog.v, W6.
PILOT_RTL = $(PWD)/../../../rtl

# SOC_GPTIMER_SRC exists so a mutation run can point the same suite at a
# modified copy of the RTL without editing the tree
# (make -f Makefile.soc_gptimer SOC_GPTIMER_SRC=/path/to/mutant.v SIM_BUILD=... ).
SOC_GPTIMER_SRC ?= $(RTL)/soc_gptimer.v

VERILOG_SOURCES = $(SOC_GPTIMER_SRC) $(RTL)/soc_wdog.v \
                  $(RTL)/soc_tmr_bank.v $(PILOT_RTL)/tmr_voter.v
TOPLEVEL = soc_gptimer

# The parameters test_soc_gptimer.py derives its expectations from. The
# watchdog is built small here so a full timeout is a few thousand clocks;
# soc_top.v instantiates WDOG_WIDTH 16 and WDOG_PRESCALE 16.
COMPILE_ARGS += -Psoc_gptimer.NGEN=2
COMPILE_ARGS += -Psoc_gptimer.WDOG_WIDTH=8
COMPILE_ARGS += -Psoc_gptimer.WDOG_PRESCALE=4
COMPILE_ARGS += -Psoc_gptimer.WDOG_RST_CYCLES=8
COMPILE_ARGS += -Psoc_gptimer.IRQ_NUM=8
MODULE = test_soc_gptimer

# Per-block build and results paths so this suite can run alongside the
# others without clobbering their artifacts.
SIM_BUILD ?= sim_build_soc_gptimer
COCOTB_RESULTS_FILE ?= results_soc_gptimer.xml
export COCOTB_RESULTS_FILE

# This block includes nothing, but -I$(RTL) keeps the invocation identical
# to the sibling fabric suite and to the flow scripts.
COMPILE_ARGS += -I$(RTL)
COMPILE_ARGS += $(EXTRA_COMPILE_ARGS)

include $(shell cocotb-config --makefiles)/Makefile.sim

# Default-flag Verilator lint. The three-state machine is small enough that
# any warning here is a real one.
VERILATOR ?= $(firstword $(shell command -v verilator 2>/dev/null) \
	$(wildcard $(HOME)/oss-cad-suite/bin/verilator \
	           $(HOME)/Documents/gt2n-soc/tools/oss-cad-suite/bin/verilator \
	           $(HOME)/Downloads/oss-cad-suite-linux-x64-20260804/oss-cad-suite/bin/verilator))

.PHONY: lint
lint:
	@test -n "$(VERILATOR)" || \
		{ echo "verilator not found: install oss-cad-suite or put it on PATH"; exit 1; }
	$(VERILATOR) --lint-only -I$(RTL) $(SOC_GPTIMER_SRC) $(RTL)/soc_wdog.v \
		$(RTL)/soc_tmr_bank.v $(PILOT_RTL)/tmr_voter.v

endif
